# TruthLens AI Environment Configuration Template
# Copy this file to .env and configure your values

# Server Settings
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Model Paths (Relative to repository root or absolute)
DISTILBERT_MODEL_PATH=models/distilbert_final_256/checkpoint-7821
XGBOOST_MODEL_PATH=models/xgboost_model.joblib
TFIDF_VECTORIZER_PATH=models/tfidf_vectorizer.joblib

# LLM Reasoning Configuration (Optional - falls back gracefully to offline reasoning if unconfigured)
# Providers: groq | openai | offline
LLM_PROVIDER=offline
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Evidence Retrieval Configuration
# Providers: duckduckgo | wikipedia | mock
RETRIEVAL_PROVIDER=duckduckgo
MAX_RETRIEVED_DOCS=5
RETRIEVAL_TIMEOUT_SECONDS=10
