/* ================================
   GLOBAL
================================ */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: #0b0d12;
  color: #f5f7fa;
}

a {
  text-decoration: none;
  color: inherit;
}

button,
textarea {
  font-family: inherit;
}

.app {
  min-height: 100vh;
  background:
    radial-gradient(circle at 50% 0%, #172033 0%, #0b0d12 45%);
}


/* ================================
   NAVBAR
================================ */

.navbar {
  height: 76px;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 8%;

  border-bottom: 1px solid rgba(255, 255, 255, 0.08);

  background: rgba(11, 13, 18, 0.75);
  backdrop-filter: blur(14px);

  position: fixed;
  top: 0;
  left: 0;
  z-index: 1000;
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;

  font-size: 20px;
  font-weight: 700;
  letter-spacing: -0.4px;
}

.brand-icon {
  width: 38px;
  height: 38px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 10px;

  background: #172033;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 34px;

  font-size: 14px;
  color: #9ca6b7;
}

.nav-links a {
  transition: 0.2s ease;
}

.nav-links a:hover {
  color: #ffffff;
}


/* ================================
   HERO
================================ */

.hero-section {
  min-height: calc(100vh - 76px);

  display: flex;
  flex-direction: column;
  align-items: center;

  text-align: center;

  padding: 150px 20px 100px;
}

.hero-badge {
  display: flex;
  align-items: center;
  gap: 8px;

  padding: 8px 15px;

  border-radius: 999px;

  font-size: 13px;
  color: #aeb9cc;

  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.09);
}

.hero-section h1 {
  margin-top: 28px;

  max-width: 900px;

  font-size: clamp(48px, 7vw, 86px);
  line-height: 1;
  letter-spacing: -4px;

  font-weight: 750;
}

.hero-section h1 span {
  color: #8fa8ff;
}

.hero-description {
  max-width: 720px;

  margin-top: 26px;

  font-size: 18px;
  line-height: 1.7;

  color: #929bad;
}


/* ================================
   VERIFICATION CARD
================================ */

.verification-card {
  width: min(850px, 95%);

  margin-top: 55px;

  padding: 22px;

  text-align: left;

  background: rgba(20, 24, 33, 0.9);

  border: 1px solid rgba(255, 255, 255, 0.1);

  border-radius: 20px;

  box-shadow:
    0 25px 80px rgba(0, 0, 0, 0.35);
}

.input-header {
  display: flex;
  align-items: center;
  gap: 9px;

  margin-bottom: 15px;

  color: #cbd3e1;

  font-size: 14px;
  font-weight: 600;
}

.verification-card textarea {
  width: 100%;

  resize: vertical;

  min-height: 190px;

  padding: 18px;

  border-radius: 12px;

  border: 1px solid rgba(255, 255, 255, 0.08);

  background: #0d1016;

  color: #f5f7fa;

  outline: none;

  font-size: 15px;
  line-height: 1.6;
}

.verification-card textarea::placeholder {
  color: #596273;
}

.verification-card textarea:focus {
  border-color: rgba(143, 168, 255, 0.6);
}

.input-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-top: 16px;

  color: #697386;

  font-size: 12px;
}

.input-footer button {
  display: flex;
  align-items: center;
  gap: 9px;

  padding: 12px 18px;

  border: none;
  border-radius: 10px;

  background: #8fa8ff;
  color: #080a0f;

  font-size: 14px;
  font-weight: 700;

  cursor: pointer;

  transition: 0.2s ease;
}

.input-footer button:hover {
  transform: translateY(-2px);

  box-shadow:
    0 8px 25px rgba(143, 168, 255, 0.25);
}


/* ================================
   HOW IT WORKS
================================ */

.how-section {
  max-width: 1100px;

  margin: 0 auto;

  padding: 120px 20px;
}

.section-heading {
  text-align: center;
}

.section-heading p {
  font-size: 12px;
  font-weight: 700;

  letter-spacing: 2px;

  color: #8fa8ff;
}

.section-heading h2 {
  margin-top: 14px;

  font-size: 42px;

  letter-spacing: -1.5px;
}

.section-heading span {
  display: block;

  max-width: 650px;

  margin: 18px auto 0;

  color: #858e9f;

  line-height: 1.6;
}


/* ================================
   FEATURE CARDS
================================ */

.feature-grid {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 20px;

  margin-top: 55px;
}

.feature-card {
  padding: 30px;

  min-height: 220px;

  border-radius: 16px;

  background: rgba(20, 24, 33, 0.75);

  border: 1px solid rgba(255, 255, 255, 0.08);

  transition: 0.25s ease;
}

.feature-card:hover {
  transform: translateY(-5px);

  border-color: rgba(143, 168, 255, 0.3);
}

.feature-number {
  font-size: 13px;

  color: #8fa8ff;

  font-weight: 700;

  margin-bottom: 35px;
}

.feature-card h3 {
  font-size: 21px;

  margin-bottom: 12px;
}

.feature-card p {
  color: #858e9f;

  font-size: 14px;

  line-height: 1.7;
}


/* ================================
   FOOTER
================================ */

footer {
  padding: 35px 8%;

  border-top: 1px solid rgba(255, 255, 255, 0.08);

  display: flex;
  align-items: center;
  justify-content: space-between;

  color: #737c8d;
}

footer .brand {
  color: #f5f7fa;

  font-size: 16px;
}

footer .brand-icon {
  width: 32px;
  height: 32px;
}

footer p {
  font-size: 13px;
}


/* ================================
   RESPONSIVE
================================ */

@media (max-width: 768px) {

  .navbar {
    padding: 0 5%;
  }

  .nav-links {
    gap: 15px;
  }

  .hero-section {
    padding-top: 80px;
  }

  .hero-section h1 {
    letter-spacing: -2px;
  }

  .hero-description {
    font-size: 16px;
  }

  .feature-grid {
    grid-template-columns: 1fr;
  }

  footer {
    flex-direction: column;
    gap: 15px;
    text-align: center;
  }
}

@media (max-width: 500px) {

  .nav-links a:nth-child(2),
  .nav-links a:nth-child(3) {
    display: none;
  }

  .hero-section h1 {
    font-size: 46px;
  }

  .verification-card {
    padding: 15px;
  }

  .input-footer {
    align-items: flex-end;
    gap: 12px;
  }

  .input-footer button span {
    display: none;
  }
}

/* ================================
   RESULT PAGE
================================ */

.result-section {
  max-width: 1100px;
  margin: 0 auto;
  padding: 150px 20px 100px;
}

.result-top {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 35px;
}

.result-label {
  color: #8fa8ff;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 2px;
  margin-bottom: 10px;
}

.result-top h1 {
  font-size: 46px;
  letter-spacing: -2px;
}

.reset-button {
  display: flex;
  align-items: center;
  gap: 8px;

  padding: 11px 16px;

  border-radius: 10px;

  border: 1px solid rgba(255, 255, 255, 0.1);

  background: rgba(255, 255, 255, 0.04);

  color: #c5ccda;

  cursor: pointer;

  transition: 0.2s ease;
}

.reset-button:hover {
  background: rgba(255, 255, 255, 0.08);
}


/* VERDICT */

.verdict-card {
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 22px;
  align-items: center;

  padding: 28px;

  border-radius: 18px;

  background: rgba(20, 24, 33, 0.9);

  border: 1px solid rgba(143, 168, 255, 0.18);

  margin-bottom: 20px;
}

.verdict-icon {
  width: 64px;
  height: 64px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 15px;

  background: rgba(86, 211, 142, 0.1);

  color: #63d99a;
}

.verdict-status {
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 1px;
  color: #63d99a;
}

.verdict-content h2 {
  margin-top: 7px;

  font-size: 20px;
  line-height: 1.4;
}

.verdict-content p {
  margin-top: 8px;

  color: #7f899b;

  font-size: 13px;
  line-height: 1.6;
}

.confidence {
  text-align: right;
}

.confidence span {
  display: block;

  color: #7f899b;

  font-size: 12px;

  margin-bottom: 4px;
}

.confidence strong {
  font-size: 32px;
}


/* RESULT CARDS */

.result-card {
  padding: 25px;

  background: rgba(20, 24, 33, 0.75);

  border: 1px solid rgba(255, 255, 255, 0.08);

  border-radius: 16px;

  margin-bottom: 20px;
}

.result-card-header {
  display: flex;
  align-items: center;
  gap: 9px;

  font-size: 14px;
  font-weight: 700;

  color: #d5dbe7;

  margin-bottom: 18px;
}

.submitted-claim {
  color: #aab3c2;

  line-height: 1.7;

  font-size: 15px;
}

.result-grid {
  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 20px;
}

.explanation {
  color: #858e9f;

  font-size: 14px;

  line-height: 1.7;

  margin-bottom: 14px;
}


/* SOURCE SCORE */

.source-score > div:first-child {
  display: flex;
  justify-content: space-between;

  color: #9da7b8;

  font-size: 13px;
}

.source-score strong {
  color: #f5f7fa;
}

.progress-bar {
  width: 100%;
  height: 7px;

  margin-top: 12px;

  border-radius: 999px;

  background: #252b36;

  overflow: hidden;
}

.progress-fill {
  height: 100%;

  border-radius: inherit;

  background: #8fa8ff;
}

.small-text {
  margin-top: 15px;

  color: #737d8e;

  font-size: 12px;

  line-height: 1.6;
}


/* EVIDENCE */

.evidence-item {
  display: flex;
  align-items: flex-start;
  gap: 15px;

  padding: 18px 0;

  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.evidence-status {
  width: 36px;
  height: 36px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 9px;
}

.evidence-status.supporting {
  background: rgba(86, 211, 142, 0.1);
  color: #63d99a;
}

.evidence-status.conflicting {
  background: rgba(255, 190, 80, 0.1);
  color: #ffbf5f;
}

.evidence-content {
  flex: 1;
}

.evidence-title {
  font-size: 14px;
  font-weight: 700;

  margin-bottom: 6px;
}

.evidence-content p {
  color: #80899a;

  font-size: 13px;

  line-height: 1.6;
}

.source-name {
  display: inline-block;

  margin-top: 9px;

  font-size: 11px;

  color: #8fa8ff;
}


/* MOBILE */

@media (max-width: 700px) {

  .result-top {
    align-items: flex-start;
    flex-direction: column;
  }

  .result-top h1 {
    font-size: 36px;
  }

  .verdict-card {
    grid-template-columns: auto 1fr;
  }

  .confidence {
    grid-column: 2;
    text-align: left;
  }

  .result-grid {
    grid-template-columns: 1fr;
  }
}